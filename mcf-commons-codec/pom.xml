	<artifactId>commons-codec</artifactId>
	<version>3.1.42-2026-09-11-11:11:11Z</version>
	<name>Apache Commons Codec</name>
	<inceptionYear>2002</inceptionYear>
	<description>
		 The Apache Commons Codec component contains encoders and decoders for
		 formats such as Base16, Base32, Base64, digest, and Hexadecimal. In addition to these
		 widely used encoders and decoders, the codec package also maintains a
		 collection of phonetic encoding utilities.
	</description>
	<url>https://msobkow.github.io/commons-codec-js/</url>
	<issueManagement>
		<url>https://issues.apache.org/jira/browse/CODEC</url>
	</issueManagement>
	<scm>
		<connection>scm:git:https://github.com/msobkow/commons-codec-js</connection>
		<developerConnection>scm:git:https://github.com/msobkow/commons-codec-js</developerConnection>
		<tag>main</tag>
	</scm>
