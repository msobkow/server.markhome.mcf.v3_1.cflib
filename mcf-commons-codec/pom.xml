	<properties>
		<commons.rc.version>MCFRC1</commons.rc.version>
		<project.build.outputTimestamp>2026-09-11-11:11:11Z</project.build.outputTimestamp>
		<commons.distSvnStagingBase>scm:git:https://github.com/msobkow/</commons.distSvnStagingBase>
		<commons.componentid>codec</commons.componentid>
		<commons.distSvnStagingUrl>${commons.distSvnStagingBase}${commons.componentid}${commons.rc.version}</commons.distSvnStagingUrl>
		<commons.module.name>org.apache.commons.${commons.componentid}</commons.module.name>
		<commons.repo.name>commons-${commons.componentid}-js</commons.repo.name>
		<commons.jira.id>CODEC</commons.jira.id>
		<commons.jira.pid>12310464</commons.jira.pid>
		<commons.release.version>1.22.1</commons.release.version>
		<commons.bc.version>1.22.0</commons.bc.version>
		<commons.release.next>1.22.2</commons.release.next>
		<commons.release.isDistModule>true</commons.release.isDistModule>
		<!--project.build.outputTimestamp>${env.BUILD_STAMP}</project.build.outputTimestamp-->
		<jacoco.skip>false</jacoco.skip>
		<commons.jacoco.haltOnFailure>true</commons.jacoco.haltOnFailure>
		<commons.jacoco.classRatio>0.92</commons.jacoco.classRatio>
		<commons.jacoco.instructionRatio>0.91</commons.jacoco.instructionRatio>
		<commons.jacoco.methodRatio>0.87</commons.jacoco.methodRatio>
		<commons.jacoco.branchRatio>0.86</commons.jacoco.branchRatio>
		<commons.jacoco.lineRatio>0.89</commons.jacoco.lineRatio>
		<commons.jacoco.complexityRatio>0.84</commons.jacoco.complexityRatio>
		<js.output.name>commons-${commons.componentid}.js</js.output.name>
	</properties>
	<build>
		<defaultGoal>clean verify apache-rat:check japicmp:cmp pmd:check spotbugs:check javadoc:javadoc</defaultGoal>
		<extensions>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ssh-external</artifactId>
				<version>1.0-beta-6</version>
			</extension>
	</extensions>
	<plugins>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-deploy-plugin</artifactId>
			<version>3.1.4</version>
			<configuration>
				<skip>true</skip>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.sonatype.plugins</groupId>
			<artifactId>nexus-staging-maven-plugin</artifactId>
			<version>1.5.1</version>
			<executions>
				<execution>
					<id>default-deploy</id>
					<phase>deploy</phase>
					<goals>
						<goal>deploy</goal>
					</goals>
				</execution>
			</executions>
			<configuration>
				<serverId>nexus</serverId>
				<nexusUrl>http://nexus3.mcf.markhome.server:8081/repository/mcf.markhome.server-hosted/</nexusUrl>
				<skipStaging>true</skipStaging>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-plugin</artifactId>
			<configuration>
				<excludes>
					<exclude>**/*PerformanceTest.java</exclude>
				</excludes>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-compiler-plugin</artifactId>
			<version>${maven-compiler.version}</version>
			<executions>
				<execution>
					<goals>
						<goal>compile</goal>
					</goals>
				</execution>
			</executions>
			<configuration>
				<executable>export PATH=${env.JAVA_JDK_HOME}/bin:${env.JAVA_JDK_HOME}/lib:${env.BASE_PATH} &amp;&amp; export JAVA_HOME=${env.JAVA_JDK_HOME} &amp;&amp; export JDK_HOME={env.JAVA_JDK_HOME} &amp;&amp; javac </executable>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-toolchains-plugin</artifactId>
			<version>${maven-toolchains.version}</version>
			<executions>
				<execution>
					<goals>
						<goal>toolchain</goal>
					</goals>
				</execution>
			</executions>
			<configuration>
				<toolchains>
					<jdk>
						<version>25-lts</version>
						<vendor>adoptium</vendor>
					</jdk>
					<jdk>
						<version>graalvm-ce-25</version>
						<vendor>graalvm.org</vendor>
					</jdk>
				</toolchains>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.graalvm.buildtools</groupId>
			<artifactId>native-maven-plugin</artifactId>
			<version>${graalvm-buildtools.version}</version>
			<extensions>true</extensions>
			<executions>
				<execution>
					<id>build-native</id>
					<goals>
						<goal>compile-no-fork</goal>
					</goals>
					<phase>package</phase>
				</execution>
			</executions>
			<configuration>
				<executable>export PATH=${env.GRAAL_JDK_HOME}/bin:${env.GRAAL_JDK_HOME}/lib:${env.BASE_PATH} &amp;&amp; export GRAALVM_HOME=${env.GRAAL_JDK_HOME} &amp;&amp; export JAVA_HOME=${env.GRAAL_JDK_HOME} &amp;&amp; export JDK_HOME={env.GRAAL_JDK_HOME} &amp;&amp; native-image </executable>
				<buildArgs>
					<buildArg>-g</buildArg>
					<buildArg>&#45;&#45;enable-monitoring=heapdump,jfr,jvmstat,jmxserver,jmxclient,threaddump,nmt,jccmd</buildArg>
					<buildArg>&#45;&#45;enable-native-access=ALL-UNNAMED</buildArg>
					<buildArg>&#45;&#45;exact-reachability-metadata</buildArg>
					<buildArg>&#45;&#45;future-defaults</buildArg>
					<buildArg>&#45;&#45;implicit:class</buildArg>
					<buildArg>&#45;H:Preserve=all</buildArg>
					<buildArg>-o ${project.build.directory}/js/${js.output.name}</buildArg>
				</buildArgs>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-scm-publish-plugin</artifactId>
			<version>${commons.scm-publish.version}</version>
			<configuration>
				<ignorePathsToDelete>
					<ignorePathToDelete>archive**</ignorePathToDelete>
				</ignorePathsToDelete>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.apache.rat</groupId>
			<artifactId>apache-rat-plugin</artifactId>
			<configuration>
				<inputExcludes>
					<inputExclude>src/test/resources/org/apache/commons/codec/bla.tar</inputExclude>
					<inputExclude>src/test/resources/org/apache/commons/codec/bla.tar.xz</inputExclude>
					<inputExclude>src/test/resources/org/apache/commons/codec/empty.bin</inputExclude>
					<inputExclude>src/test/resources/org/apache/commons/codec/small.bin</inputExclude>
				</inputExcludes>
			</configuration>
		</plugin>
		<plugin>
			<artifactId>maven-jar-plugin</artifactId>
			<configuration>
				<archive combine.children="append">
					<manifestEntries>
						<Automatic-Module-Name>${commons.module.name}</Automatic-Module-Name>
					</manifestEntries>
				</archive>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-assembly-plugin</artifactId>
			<configuration>
				<descriptors>
					<descriptor>src/assembly/bin.xml</descriptor>
					<descriptor>src/assembly/src.xml</descriptor>
				</descriptors>
				<tarLongFileMode>gnu</tarLongFileMode>
			</configuration>
		</plugin>
		<plugin>
			<artifactId>maven-javadoc-plugin</artifactId>
			<configuration>
				<source>${maven.compiler.source}</source>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.codehaus.mojo</groupId>
			<artifactId>animal-sniffer-maven-plugin</artifactId>
			<version>${commons.animal-sniffer.version}</version>
			<configuration>
				<ignores>
					<ignore>java.nio.ByteBuffer</ignore>
				</ignores>
			</configuration>
		</plugin>
	</plugins>
</build>
